{
  "manifest_version": 3,
  "name": "CyberPage",
  "description": "MAGI-themed new tab page with weather, RSS, bookmarks and quick links.",
  "version": "1.0",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "geolocation",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://api.openweathermap.org/*",
    "https://openweathermap.org/*"
  ],
  "icons": {
    "16": "./icons/icon-16.png",
    "48": "./icons/icon-48.png",
    "128": "./icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "com.pdromnt.cyberpage"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'"
  }
}
